<?xml version="1.0" encoding="utf-8"?>
<!--
    The window the OS paints while the process starts, on Android 11 and below
    (Android 12+ uses the SplashScreen API — see values-v31/styles.xml). Same
    mark, same background colour, so every launch path looks identical.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash_background" />
    <item
        android:drawable="@drawable/splash_mark"
        android:gravity="center"
        android:width="180dp"
        android:height="180dp" />
</layer-list>
