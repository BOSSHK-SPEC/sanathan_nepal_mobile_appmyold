<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Sanatan Nepal uses your location to show local weather.</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Sanatan Nepal</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>sanathan_nepal_mobile_app</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<!-- Shown verbatim in the iOS permission prompt. iOS terminates the app
	     when a picker opens without one, so these are required, not optional —
	     and they say what the photo is for, because "this app needs access" is
	     what makes people decline. -->
	<key>NSCameraUsageDescription</key>
	<string>Take a photo for your profile, a product listing or a verification document.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Choose a photo for your profile, a product listing or a verification document.</string>
	<!-- Lets a notification arriving while the app is closed be handled before
	     it is shown. Without it, iOS delivers data-only messages late or not
	     at all. -->
	<!-- Shown when a consultation call asks for the microphone. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Talk to an astrologer during a voice or video consultation.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
		<!-- Keeps a call running when the screen locks or the user switches
		     apps; without it iOS suspends the process and the call drops. -->
		<string>audio</string>
	</array>
</dict>
</plist>
